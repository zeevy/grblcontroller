+    private void handleReceivedLine(String line) {
+        // centralize status parsing by protocol
+        String normalized = statusParser.parse(line);
+        if (normalized != null) {
+            // broadcast normalized status for UI to consume
+            Intent intent = new Intent("in.co.gorest.grblcontroller.STATUS");
+            intent.putExtra("status", normalized);
+            sendBroadcast(intent);
+        } else {
+            // fallback: broadcast raw line in case UI expects it
+            Intent intent = new Intent("in.co.gorest.grblcontroller.RAW_LINE");
+            intent.putExtra("raw", line);
+            sendBroadcast(intent);
+        }
+    }
