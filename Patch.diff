+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Button;
+import android.widget.RadioButton;
+
+public class SettingsProtocolActivity extends Activity {
+    private Protocol selected = Protocol.GRB L;
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_settings_protocol);
+        RadioButton rGrbl = findViewById(R.id.r_grbl);
+        RadioButton rFluid = findViewById(R.id.r_fluidnc);
+        RadioButton rHal = findViewById(R.id.r_grblhal);
+        Button btnOk = findViewById(R.id.btn_ok_protocol);
+
+        rGrbl.setOnClickListener(v -> selected = Protocol.GRB L);
+        rFluid.setOnClickListener(v -> selected = Protocol.FLUIDNC);
+        rHal.setOnClickListener(v -> selected = Protocol.GRB LHAL);
+
+        btnOk.setOnClickListener(v -> {
+            Intent i = new Intent();
+            i.putExtra("protocol", selected.name());
+            setResult(RESULT_OK, i);
+            finish();
+        });
+    }
+}
